-- =========================================================
--  LOAD MODULES INTO PAGES
-- =========================================================
local function loadModule(pageName, url)
	local page = pages[pageName]
	local status = Instance.new("TextLabel")
	status.Size = UDim2.new(1, 0, 0, 30)
	status.Position = UDim2.fromOffset(0, 10)
	status.BackgroundTransparency = 1
	status.Text = "Loading..."
	status.TextColor3 = Color3.fromRGB(180, 180, 190)
	status.TextSize = 14
	status.Font = Enum.Font.Gotham
	status.Parent = page

	task.spawn(function()
		local success, err = pcall(function()
			_G.UnifiedHubLoading = true
			_G.HubPageParent = page          -- tell the script where to put its GUI
			local code = game:HttpGet(url)
			loadstring(code)()
			_G.UnifiedHubLoading = false
			_G.HubPageParent = nil
		end)

		if success then
			status:Destroy()
		else
			status.Text = "Failed to load"
			status.TextColor3 = Color3.fromRGB(220, 100, 100)
			warn("[Kttyz Hub] Failed to load " .. pageName .. ":", err)
		end
	end)
end

loadModule("lssr", LINKS.lssrsw)
loadModule("invis", LINKS.invis)
loadModule("freecam", LINKS.fc)

-- =========================================================
--  CLEANUP
-- =========================================================
local function cleanup()
	if _G.PlayerWatchlistCleanup then pcall(_G.PlayerWatchlistCleanup) end
	if _G.InvisiblePlayerToolCleanup then pcall(_G.InvisiblePlayerToolCleanup) end
	if _G.FreecamCleanup then pcall(_G.FreecamCleanup) end

	for _, c in ipairs(connections) do
		pcall(function() c:Disconnect() end)
	end
	if gui then gui:Destroy() end
end

_G.UnifiedHubCleanup = cleanup
connect(closeBtn.MouseButton1Click, cleanup)

showPage("home")
