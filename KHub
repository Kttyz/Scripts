	Instance.new("UICorner", preview).CornerRadius = UDim.new(0, 4)

	local changeBtn = Instance.new("TextButton")
	changeBtn.Size = UDim2.fromOffset(70, 24)
	changeBtn.Position = UDim2.new(1, -80, 0.5, -12)
	changeBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 70)
	changeBtn.Text = "Change"
	changeBtn.TextColor3 = Color3.new(1, 1, 1)
	changeBtn.TextSize = 12
	changeBtn.Font = Enum.Font.GothamBold
	changeBtn.AutoButtonColor = false
	changeBtn.Parent = frame
	Instance.new("UICorner", changeBtn).CornerRadius = UDim.new(0, 4)

	changeBtn.MouseButton1Click:Connect(function()
		local presets = {
			mainBg = {{25,25,30},{30,30,40},{20,22,28},{35,30,40},{15,18,25}},
			boxBg = {{35,35,42},{40,40,50},{45,40,55},{30,35,45},{38,38,48}},
			button = {{70,90,160},{80,70,160},{60,120,100},{140,80,80},{90,90,110}},
			toggleOn = {{50,140,80},{60,160,90},{40,130,100},{80,140,60},{50,120,140}},
			toggleOff = {{60,60,70},{70,70,80},{55,55,65},{65,60,70},{50,55,65}},
			accent = {{80,80,95},{90,85,110},{70,90,100},{100,80,90},{75,75,90}}
		}
		local list = presets[colorKey]
		if not list then return end
		local current = col[colorKey]
		local idx = 1
		for i, v in ipairs(list) do
			if v[1] == current[1] and v[2] == current[2] and v[3] == current[3] then idx = i break end
		end
		idx = idx % #list + 1
		col[colorKey] = list[idx]
		saveData.colors[colorKey] = list[idx]
		writeSave()
		preview.BackgroundColor3 = rgb(col[colorKey])
		if colorKey == "mainBg" then main.BackgroundColor3 = rgb(col.mainBg)
		elseif colorKey == "accent" then mainStroke.Color = rgb(col.accent)
		elseif colorKey == "boxBg" then
			for _, data in pairs(featureBoxes) do data.box.BackgroundColor3 = rgb(col.boxBg) end
		elseif colorKey == "button" then
			for _, data in pairs(featureBoxes) do
				if not data.isToggle then data.actionBtn.BackgroundColor3 = rgb(col.button) end
			end
		elseif colorKey == "toggleOn" or colorKey == "toggleOff" then
			for name, data in pairs(featureBoxes) do
				if data.isToggle then
					local state = features[name] and features[name].enabled
					data.actionBtn.BackgroundColor3 = state and rgb(col.toggleOn) or rgb(col.toggleOff)
				end
			end
		end
		notify("Theme", name .. " updated")
	end)
end

