-- ==================== HELPERS ====================
local function getRoot(char)
	return char and (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso") or char.PrimaryPart)
end

local function findPlayer(name)
	if not name or name == "" then return nil end
	name = name:lower()
	for _, p in ipairs(Players:GetPlayers()) do
		if p.Name:lower():find(name, 1, true) or p.DisplayName:lower():find(name, 1, true) then return p end
	end
end

-- ==================== FEATURES ====================
local flyBV, flyBG, flyConn
local function setFly(state)
	features.Fly.enabled = state
	saveData.toggles.Fly = state
	writeSave()
	local char = LocalPlayer.Character
	local hrp = getRoot(char)
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not hrp or not hum then return end
	if state then
		flyBV = Instance.new("BodyVelocity")
		flyBV.MaxForce = Vector3.new(9e9, 9e9, 9e9)
		flyBV.Parent = hrp
		flyBG = Instance.new("BodyGyro")
		flyBG.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
		flyBG.P = 9e4
		flyBG.Parent = hrp
		hum.PlatformStand = true
		flyConn = RunService.RenderStepped:Connect(function()
			if not features.Fly.enabled or not hrp.Parent then return end
			local cam = workspace.CurrentCamera
			local dir = Vector3.zero
			if UserInputService:IsKeyDown(Enum.KeyCode.W) then dir += cam.CFrame.LookVector end
			if UserInputService:IsKeyDown(Enum.KeyCode.S) then dir -= cam.CFrame.LookVector end
			if UserInputService:IsKeyDown(Enum.KeyCode.A) then dir -= cam.CFrame.RightVector end
			if UserInputService:IsKeyDown(Enum.KeyCode.D) then dir += cam.CFrame.RightVector end
			if UserInputService:IsKeyDown(Enum.KeyCode.Space) then dir += Vector3.yAxis end
			if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then dir -= Vector3.yAxis end
			flyBV.Velocity = dir.Magnitude > 0 and dir.Unit * 60 or Vector3.zero
			flyBG.CFrame = cam.CFrame
		end)
	else
		if flyConn then flyConn:Disconnect() flyConn = nil end
		if flyBV then flyBV:Destroy() flyBV = nil end
		if flyBG then flyBG:Destroy() flyBG = nil end
		if hum then hum.PlatformStand = false end
	end
end

local function clearHL(tbl)
	for _, h in pairs(tbl) do if h and h.Parent then h:Destroy() end end
	table.clear(tbl)
end

local function updateESP()
	clearHL(features.ESP.highlights)
	if not features.ESP.enabled then return end
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LocalPlayer and plr.Character then
			local h = Instance.new("Highlight")
			h.Adornee = plr.Character
			h.FillColor = Color3.fromRGB(100, 200, 255)
			h.OutlineColor = Color3.fromRGB(100, 200, 255)
			h.FillTransparency = 0.65
			h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
			h.Parent = plr.Character
			features.ESP.highlights[plr] = h
		end
	end
end

local function setESP(s)
	features.ESP.enabled = s
	saveData.toggles.ESP = s
	writeSave()
	if s then updateESP() else clearHL(features.ESP.highlights) end
end

local function updateOutlines()
	clearHL(features.Outlines.highlights)
	if not features.Outlines.enabled then return end
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LocalPlayer and plr.Character then
			local h = Instance.new("Highlight")
			h.Adornee = plr.Character
			h.FillTransparency = 1
			h.OutlineColor = Color3.new(1, 1, 1)
			h.DepthMode = Enum.HighlightDepthMode.Occluded
			h.Parent = plr.Character
			features.Outlines.highlights[plr] = h
		end
	end
end

local function setOutlines(s)
	features.Outlines.enabled = s
	saveData.toggles.Outlines = s
	writeSave()
	if s then updateOutlines() else clearHL(features.Outlines.highlights) end
end

-- Player Glow - FIXED equal brightness
local GLOW_BRIGHTNESS = 1.4
local GLOW_RANGE = 9
local GLOW_DIST = 55

local function updateGlow()
	for _, l in pairs(features.PlayerGlow.lights) do if l and l.Parent then l:Destroy() end end
	table.clear(features.PlayerGlow.lights)
	if not features.PlayerGlow.enabled then return end
	local myRoot = getRoot(LocalPlayer.Character)
	if not myRoot then return end

	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LocalPlayer and plr.Character then
			local root = getRoot(plr.Character)
			if root and (root.Position - myRoot.Position).Magnitude <= GLOW_DIST then
				local light = Instance.new("PointLight")
				light.Color = Color3.fromRGB(160, 210, 255)
				light.Brightness = GLOW_BRIGHTNESS   -- always the same
				light.Range = GLOW_RANGE
				light.Parent = root
				features.PlayerGlow.lights[plr] = light
			end
		end
	end
end

local function setPlayerGlow(s)
	features.PlayerGlow.enabled = s
	saveData.toggles.PlayerGlow = s
	writeSave()
	if s then updateGlow() else
		for _, l in pairs(features.PlayerGlow.lights) do if l then l:Destroy() end end
		table.clear(features.PlayerGlow.lights)
	end
end

task.spawn(function()
	while true do
		if features.PlayerGlow.enabled then updateGlow() end
		task.wait(0.7)
	end
end)

