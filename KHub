local function loadSave()
	if not (isfile and readfile) then return defaultSave end
	local ok, data = pcall(function() return HttpService:JSONDecode(readfile(SAVE_FILE)) end)
	if ok and type(data) == "table" then
		for k, v in pairs(defaultSave) do if data[k] == nil then data[k] = v end end
		return data
	end
	return defaultSave
end

local saveData = loadSave()
local function writeSave()
	if writefile then pcall(function() writefile(SAVE_FILE, HttpService:JSONEncode(saveData)) end) end
end

