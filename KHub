	lssrsw = "https://raw.githubusercontent.com/Kttyz/Scripts/refs/heads/main/lssrsw.lua",
	invis  = "https://raw.githubusercontent.com/Kttyz/Scripts/refs/heads/main/invis.lua",
	fc     = "https://raw.githubusercontent.com/Kttyz/Scripts/refs/heads/main/fc.lua",
	hubdsc = "https://raw.githubusercontent.com/Kttyz/Scripts/refs/heads/main/hubdsc",
}

