local stackCount = 0
local function notify(titleText, bodyText, length)
	playNotifySound()
	stackCount += 1
	local slot = stackCount
	local frame = Instance.new("Frame")
	frame.BackgroundColor3 = Color3.fromRGB(36, 36, 37)
	frame.BorderSizePixel = 0
	frame.Size = UDim2.fromOffset(260, 90)
	frame.Position = UDim2.new(1, -280, 1, 20)
	frame.Parent = NotifyGui
	Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 6)

	local title = Instance.new("TextLabel")
	title.BackgroundColor3 = Color3.fromRGB(46, 46, 47)
	title.BorderSizePixel = 0
	title.Size = UDim2.new(1, 0, 0, 22)
	title.Font = Enum.Font.GothamBold
	title.TextSize = 14
	title.Text = titleText or "KHub"
	title.TextColor3 = Color3.new(1, 1, 1)
	title.Parent = frame

	local text = Instance.new("TextLabel")
	text.BackgroundTransparency = 1
	text.Position = UDim2.fromOffset(8, 26)
	text.Size = UDim2.new(1, -16, 1, -32)
	text.Font = Enum.Font.Gotham
	text.TextSize = 13
	text.TextColor3 = Color3.new(1, 1, 1)
	text.TextWrapped = true
	text.TextXAlignment = Enum.TextXAlignment.Left
	text.TextYAlignment = Enum.TextYAlignment.Top
	text.Text = bodyText or ""
	text.Parent = frame

	TweenService:Create(frame, TweenInfo.new(0.35, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
		Position = UDim2.new(1, -280, 1, -110 - ((slot - 1) * 100))
	}):Play()

	task.delay(length or 4.5, function()
		TweenService:Create(frame, TweenInfo.new(0.35, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {
			Position = UDim2.new(1, -280, 1, 20)
		}):Play()
		task.wait(0.4)
		if frame then frame:Destroy() end
		stackCount = math.max(stackCount - 1, 0)
	end)
end

