-- Drag logic
connect(UserInputService.InputChanged, function(input)
	if draggingBox and input.UserInputType == Enum.UserInputType.MouseMovement then
		local mouse = UserInputService:GetMouseLocation()
		-- simple visual follow (reorder on release)
	end
end)

connect(UserInputService.InputEnded, function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 and draggingBox then
		-- Find closest box and swap LayoutOrder
		local closest, closestDist = nil, math.huge
		for _, data in pairs(featureBoxes) do
			if data.box ~= draggingBox then
				local dist = (data.box.AbsolutePosition - draggingBox.AbsolutePosition).Magnitude
				if dist < closestDist then
					closestDist = dist
					closest = data.box
				end
			end
		end
		if closest and closestDist < 120 then
			local temp = draggingBox.LayoutOrder
			draggingBox.LayoutOrder = closest.LayoutOrder
			closest.LayoutOrder = temp
		end
		draggingBox.ZIndex = 1
		draggingBox = nil
	end
end)

