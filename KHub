local function doGoto(name)
	local target = findPlayer(name)
	if not target then notify("Goto", "Player not found") return end
	local root = getRoot(LocalPlayer.Character)
	local tRoot = getRoot(target.Character)
	if root and tRoot then
		local hum = LocalPlayer.Character:FindFirstChildWhichIsA("Humanoid")
		if hum and hum.SeatPart then hum.Sit = false task.wait(0.1) end
		root.CFrame = tRoot.CFrame + Vector3.new(0, 3, 0)
		notify("Goto", "Teleported to " .. target.DisplayName)
	end
end

local function doView(name)
	local target = findPlayer(name)
	if not target then notify("View", "Player not found") return false end
	for _, c in pairs(viewConns) do pcall(function() c:Disconnect() end) end
	viewConns = {}
	viewingPlayer = target
	workspace.CurrentCamera.CameraSubject = target.Character
	table.insert(viewConns, target.CharacterAdded:Connect(function()
		task.wait(0.3)
		if viewingPlayer == target then
			workspace.CurrentCamera.CameraSubject = target.Character
		end
	end))
	notify("View", "Now viewing " .. target.DisplayName)
	return true
end

local function doUnview()
	for _, c in pairs(viewConns) do pcall(function() c:Disconnect() end) end
	viewConns = {}
	viewingPlayer = nil
	local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildWhichIsA("Humanoid")
	if hum then workspace.CurrentCamera.CameraSubject = hum end
	notify("View", "Stopped viewing")
end

local function doServerHop()
	notify("Serverhop", "Finding server...")
	local ok, req = pcall(function()
		return game:HttpGet("https://games.roblox.com/v1/games/" .. PlaceId .. "/servers/Public?sortOrder=Desc&limit=100&excludeFullGames=true")
	end)
	if not ok then notify("Serverhop", "Failed to get servers") return end
	local body = HttpService:JSONDecode(req)
	local servers = {}
	if body and body.data then
		for _, v in ipairs(body.data) do
			if v.playing and v.maxPlayers and v.playing < v.maxPlayers and v.id ~= JobId then
				table.insert(servers, v.id)
			end
		end
	end
	if #servers > 0 then
		TeleportService:TeleportToPlaceInstance(PlaceId, servers[math.random(1, #servers)], LocalPlayer)
	else
		notify("Serverhop", "No available servers")
	end
end

