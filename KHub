-- Spin
local function setSpin(state, speed)
	features.Spin.enabled = state
	saveData.toggles.Spin = state
	writeSave()
	if features.Spin.conn then features.Spin.conn:Disconnect() features.Spin.conn = nil end
	if state then
		local spd = tonumber(speed) or saveData.spinSpeed or 20
		features.Spin.conn = RunService.RenderStepped:Connect(function(dt)
			local root = getRoot(LocalPlayer.Character)
			if root then
				root.CFrame = root.CFrame * CFrame.Angles(0, math.rad(spd * 10 * dt), 0)
			end
		end)
	end
end

