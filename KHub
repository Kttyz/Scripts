-- Resize
local resizing, rStart, rSize
connect(resizeHandle.InputBegan, function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		resizing = true
		rStart = input.Position
		rSize = main.AbsoluteSize
	end
end)
connect(UserInputService.InputChanged, function(input)
	if resizing and input.UserInputType == Enum.UserInputType.MouseMovement then
		local d = input.Position - rStart
		local w = math.clamp(rSize.X + d.X, 380, 950)
		local h = math.clamp(rSize.Y + d.Y, 340, 980)
		expandedSize = Vector2.new(w, h)
		main.Size = UDim2.fromOffset(w, h)
		local columns = 2
		if w > 640 then columns = 3 end
		if w > 860 then columns = 4 end
		grid.FillDirectionMaxCells = columns
		local cellW = math.floor((w - 30 - (columns-1)*8) / columns)
		grid.CellSize = UDim2.fromOffset(math.clamp(cellW, 165, 220), 80)
	end
end)
connect(UserInputService.InputEnded, function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then resizing = false end
end)

