local nextOrder = 1
local draggingBox = nil
local dragOffset = Vector2.zero

local function createBox(name, opts)
	opts = opts or {}
	local isToggle = opts.toggle
	local hasInput = opts.input
	local placeholder = opts.placeholder or ""
	local defaultNum = opts.default or ""

	local box = Instance.new("Frame")
	box.LayoutOrder = nextOrder
	nextOrder += 1
	box.BackgroundColor3 = rgb(col.boxBg)
	box.BorderSizePixel = 0
	box.Parent = content
	Instance.new("UICorner", box).CornerRadius = UDim.new(0, 6)

	local nameLabel = Instance.new("TextLabel")
	nameLabel.Size = UDim2.new(1, -70, 0, 18)
	nameLabel.Position = UDim2.fromOffset(8, 4)
	nameLabel.BackgroundTransparency = 1
	nameLabel.Text = name
	nameLabel.TextColor3 = Color3.fromRGB(240, 240, 245)
	nameLabel.TextSize = 12
	nameLabel.Font = Enum.Font.GothamSemibold
	nameLabel.TextXAlignment = Enum.TextXAlignment.Left
	nameLabel.Parent = box

	local keyBtn = Instance.new("TextButton")
	keyBtn.Size = UDim2.fromOffset(48, 18)
	keyBtn.Position = UDim2.new(1, -56, 0, 4)
	keyBtn.BackgroundColor3 = Color3.fromRGB(55, 55, 65)
	keyBtn.Text = (features[name] and features[name].keybind) and features[name].keybind.Name or "None"
	keyBtn.TextColor3 = Color3.fromRGB(200, 200, 210)
	keyBtn.TextSize = 10
	keyBtn.Font = Enum.Font.Gotham
	keyBtn.AutoButtonColor = false
	keyBtn.Parent = box
	Instance.new("UICorner", keyBtn).CornerRadius = UDim.new(0, 4)

	local inputBox
	if hasInput then
		inputBox = Instance.new("TextBox")
		inputBox.Size = UDim2.new(1, -16, 0, 20)
		inputBox.Position = UDim2.fromOffset(8, 26)
		inputBox.BackgroundColor3 = Color3.fromRGB(50, 50, 58)
		inputBox.BorderSizePixel = 0
		inputBox.PlaceholderText = placeholder
		inputBox.Text = tostring(defaultNum)
		inputBox.TextColor3 = Color3.new(1, 1, 1)
		inputBox.PlaceholderColor3 = Color3.fromRGB(140, 140, 150)
		inputBox.TextSize = 12
		inputBox.Font = Enum.Font.Gotham
		inputBox.ClearTextOnFocus = false
		inputBox.Parent = box
		Instance.new("UICorner", inputBox).CornerRadius = UDim.new(0, 4)
	end

	local actionBtn = Instance.new("TextButton")
	actionBtn.Size = UDim2.new(1, -16, 0, 22)
	actionBtn.Position = UDim2.fromOffset(8, hasInput and 50 or 28)
	actionBtn.BackgroundColor3 = isToggle and rgb(col.toggleOff) or rgb(col.button)
	actionBtn.Text = isToggle and "OFF" or (opts.buttonText or "Run")
	actionBtn.TextColor3 = Color3.new(1, 1, 1)
	actionBtn.TextSize = 12
	actionBtn.Font = Enum.Font.GothamBold
	actionBtn.AutoButtonColor = false
	actionBtn.Parent = box
	Instance.new("UICorner", actionBtn).CornerRadius = UDim.new(0, 4)

	-- Drag handle
	local dragHandle = Instance.new("TextButton")
	dragHandle.Size = UDim2.fromOffset(20, 16)
	dragHandle.Position = UDim2.new(1, -22, 1, -18)
	dragHandle.BackgroundTransparency = 1
	dragHandle.Text = "///"
	dragHandle.TextColor3 = Color3.fromRGB(130, 130, 140)
	dragHandle.TextSize = 11
	dragHandle.Font = Enum.Font.GothamBold
	dragHandle.AutoButtonColor = false
	dragHandle.Parent = box

	keybindButtons[name] = keyBtn
	featureBoxes[name] = {box = box, actionBtn = actionBtn, inputBox = inputBox, isToggle = isToggle, dragHandle = dragHandle, name = name}

	keyBtn.MouseButton1Click:Connect(function()
		if settingKeybind then return end
		settingKeybind = name
		keyBtn.Text = "..."
		keyBtn.BackgroundColor3 = Color3.fromRGB(140, 100, 50)
	end)

	-- Drag start
	dragHandle.MouseButton1Down:Connect(function()
		draggingBox = box
		local mouse = UserInputService:GetMouseLocation()
		dragOffset = Vector2.new(mouse.X - box.AbsolutePosition.X, mouse.Y - box.AbsolutePosition.Y)
		box.ZIndex = 10
	end)

	return box, actionBtn, inputBox
end

