-- ==================== KEYBINDS ====================
connect(UserInputService.InputBegan, function(input, gp)
	if gp or input.UserInputType ~= Enum.UserInputType.Keyboard then return end
	local key = input.KeyCode

	if settingKeybind then
		local btn = keybindButtons[settingKeybind]
		if key == Enum.KeyCode.Escape then
			if features[settingKeybind] then features[settingKeybind].keybind = nil end
			saveData.keybinds[settingKeybind] = nil
			btn.Text = "None"
		else
			features[settingKeybind] = features[settingKeybind] or {}
			features[settingKeybind].keybind = key
			saveData.keybinds[settingKeybind] = key.Name
			btn.Text = key.Name
		end
		writeSave()
		btn.BackgroundColor3 = Color3.fromRGB(55, 55, 65)
		settingKeybind = nil
		return
	end

	local function check(name, fn)
		if features[name] and features[name].keybind == key then fn() end
	end
	check("Fly", function() setFly(not features.Fly.enabled) applyToggleVisual(flyBtn, features.Fly.enabled) end)
	check("ESP", function() setESP(not features.ESP.enabled) applyToggleVisual(espBtn, features.ESP.enabled) end)
	check("Outlines", function() setOutlines(not features.Outlines.enabled) applyToggleVisual(outlinesBtn, features.Outlines.enabled) end)
	check("PlayerGlow", function() setPlayerGlow(not features.PlayerGlow.enabled) applyToggleVisual(glowBtn, features.PlayerGlow.enabled) end)
	check("AntiFling", function() setAntiFling(not features.AntiFling.enabled) applyToggleVisual(antiFlingBtn, features.AntiFling.enabled) end)
	check("WalkFling", function() setWalkFling(not features.WalkFling.enabled) applyToggleVisual(walkFlingBtn, features.WalkFling.enabled) end)
	check("Spin", function()
		setSpin(not features.Spin.enabled, spinInput.Text)
		applyToggleVisual(spinBtn, features.Spin.enabled)
	end)
end)

