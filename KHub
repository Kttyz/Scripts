local function addColorPicker(name, colorKey)
	local frame = Instance.new("Frame")
	frame.Size = UDim2.new(1, -16, 0, 70)
	frame.BackgroundColor3 = Color3.fromRGB(40, 40, 48)
	frame.BorderSizePixel = 0
	frame.Parent = settingsPage
	Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 5)

	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(1, -20, 0, 20)
	label.Position = UDim2.fromOffset(10, 4)
	label.BackgroundTransparency = 1
	label.Text = name
	label.TextColor3 = Color3.fromRGB(230, 230, 240)
	label.TextSize = 13
	label.Font = Enum.Font.Gotham
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.Parent = frame

	local preview = Instance.new("Frame")
	preview.Size = UDim2.fromOffset(30, 22)
	preview.Position = UDim2.new(1, -40, 0, 6)
	preview.BackgroundColor3 = rgb(col[colorKey])
	preview.BorderSizePixel = 0
	preview.Parent = frame
	Instance.new("UICorner", preview).CornerRadius = UDim.new(0, 4)

	local function makeRGBBox(axis, xPos)
		local box = Instance.new("TextBox")
		box.Size = UDim2.fromOffset(50, 22)
		box.Position = UDim2.fromOffset(xPos, 36)
		box.BackgroundColor3 = Color3.fromRGB(55, 55, 65)
		box.BorderSizePixel = 0
		box.Text = tostring(col[colorKey][axis])
		box.TextColor3 = Color3.new(1, 1, 1)
		box.TextSize = 12
		box.Font = Enum.Font.Gotham
		box.ClearTextOnFocus = false
		box.Parent = frame
		Instance.new("UICorner", box).CornerRadius = UDim.new(0, 4)
		box.FocusLost:Connect(function()
			local n = math.clamp(tonumber(box.Text) or 0, 0, 255)
			box.Text = tostring(n)
			col[colorKey][axis] = n
			saveData.colors[colorKey] = col[colorKey]
			writeSave()
			preview.BackgroundColor3 = rgb(col[colorKey])
			-- apply live
			if colorKey == "mainBg" then main.BackgroundColor3 = rgb(col.mainBg)
			elseif colorKey == "accent" then mainStroke.Color = rgb(col.accent) minCircle:FindFirstChildOfClass("UIStroke").Color = rgb(col.accent)
			elseif colorKey == "boxBg" then for _, d in pairs(featureBoxes) do d.box.BackgroundColor3 = rgb(col.boxBg) end
			elseif colorKey == "button" then for _, d in pairs(featureBoxes) do if not d.isToggle then d.actionBtn.BackgroundColor3 = rgb(col.button) end end
			elseif colorKey == "toggleOn" or colorKey == "toggleOff" then
				for n, d in pairs(featureBoxes) do
					if d.isToggle then
						local st = features[n] and features[n].enabled
						d.actionBtn.BackgroundColor3 = st and rgb(col.toggleOn) or rgb(col.toggleOff)
					end
				end
			end
		end)
		return box
	end
	makeRGBBox(1, 10)
	makeRGBBox(2, 70)
	makeRGBBox(3, 130)
end

