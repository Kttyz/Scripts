local function makePageIcon(emoji, order)
	local btn = Instance.new("TextButton")
	btn.Size = UDim2.fromOffset(32, 26)
	btn.Position = UDim2.fromOffset(8 + (order - 1) * 36, 4)
	btn.BackgroundColor3 = Color3.fromRGB(45, 45, 55)
	btn.Text = emoji
	btn.TextSize = 16
	btn.Font = Enum.Font.GothamBold
	btn.TextColor3 = Color3.new(1, 1, 1)
	btn.AutoButtonColor = false
	btn.Parent = titleBar
	Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 4)
	return btn
end

local homeBtn    = makePageIcon("K", 1)
local lssrBtn    = makePageIcon("🛡️", 2)
local invisBtn   = makePageIcon("👻", 3)
local freecamBtn = makePageIcon("📷", 4)

local function makeTopButton(text, color, xOffset)
	local btn = Instance.new("TextButton")
	btn.Size = UDim2.fromOffset(26, 26)
	btn.Position = UDim2.new(1, xOffset, 0, 4)
	btn.BackgroundColor3 = color
	btn.Text = text
	btn.TextColor3 = Color3.new(1, 1, 1)
	btn.TextSize = 16
	btn.Font = Enum.Font.GothamBold
	btn.AutoButtonColor = false
	btn.Parent = titleBar
	Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 4)
	return btn
end

local minimizeBtn = makeTopButton("-", Color3.fromRGB(70, 70, 80), -62)
local closeBtn    = makeTopButton("X", Color3.fromRGB(130, 60, 65), -32)

local content = Instance.new("Frame")
content.Size = UDim2.new(1, -20, 1, -50)
content.Position = UDim2.fromOffset(10, 40)
content.BackgroundTransparency = 1
content.Parent = main

local pages = {
	home    = Instance.new("Frame"),
	lssr    = Instance.new("Frame"),
	invis   = Instance.new("Frame"),
	freecam = Instance.new("Frame"),
}

for name, page in pairs(pages) do
	page.Size = UDim2.fromScale(1, 1)
	page.BackgroundTransparency = 1
	page.Visible = false
	page.Parent = content
end

local function showPage(name)
	for n, p in pairs(pages) do
		p.Visible = (n == name)
	end
	homeBtn.BackgroundColor3    = name == "home"    and Color3.fromRGB(55, 120, 80) or Color3.fromRGB(45, 45, 55)
	lssrBtn.BackgroundColor3    = name == "lssr"    and Color3.fromRGB(55, 120, 80) or Color3.fromRGB(45, 45, 55)
	invisBtn.BackgroundColor3   = name == "invis"   and Color3.fromRGB(55, 120, 80) or Color3.fromRGB(45, 45, 55)
	freecamBtn.BackgroundColor3 = name == "freecam" and Color3.fromRGB(55, 120, 80) or Color3.fromRGB(45, 45, 55)
end

connect(homeBtn.MouseButton1Click,    function() showPage("home") end)
connect(lssrBtn.MouseButton1Click,    function() showPage("lssr") end)
connect(invisBtn.MouseButton1Click,   function() showPage("invis") end)
connect(freecamBtn.MouseButton1Click, function() showPage("freecam") end)

-- Drag
local dragging, dragStart, startPos = false, nil, nil
connect(titleBar.InputBegan, function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		dragging = true
		dragStart = input.Position
		startPos = main.Position
	end
end)
connect(UserInputService.InputChanged, function(input)
	if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
		local delta = input.Position - dragStart
		main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
	end
end)
connect(UserInputService.InputEnded, function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
end)

